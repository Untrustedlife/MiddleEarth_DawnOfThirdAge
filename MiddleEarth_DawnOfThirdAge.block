  "History": [
    {
      "regionId": "lake_evendim",
      "description": "Old chronicles recall the founding of Númenor across the sea, long before the kingdoms in exile.",
      "eventDate": {
        "CurrentDay": 1,
        "CurrentYear": -3409
      },
      "deathBlock": null,
      "processed": true,
      "associatedCreatureId": "60"
    },
    {
      "regionId": "sirannon",
      "description": "In Eregion, the smiths of the Elves work at the making of the Rings of Power; their craft will echo through later ages.",
      "eventDate": {
        "CurrentDay": 1,
        "CurrentYear": -1841
      },
      "deathBlock": null,
      "processed": true,
      "associatedCreatureId": "59"
    },
    {
      "regionId": "sirannon",
      "description": "Sauron makes war upon Eregion. Celebrimbor dies; the great treasure of the Elven-smiths is scattered.",
      "eventDate": {
        "CurrentDay": 1,
        "CurrentYear": -1750
      },
      "deathBlock": null,
      "processed": true,
      "associatedCreatureId": "59"
    },
    {
